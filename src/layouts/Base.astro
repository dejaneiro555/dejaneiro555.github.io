---
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = 'Rio Gonzales';
const pageTitle = title ? `${title} · ${siteName}` : siteName;

// Add a page here once it exists, so the nav never links to a missing page.
const navLinks: { href: string; label: string }[] = [];

const linkedIn = 'https://www.linkedin.com/in/rwgonzales';
const gitHub = 'https://github.com/dejaneiro555';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap label">
        <a href="/">{siteName}</a>
        <nav aria-label="Main">
          <ul>
            {navLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
            <li><a href={linkedIn}>LinkedIn</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap label">
        <span>© {new Date().getFullYear()} {siteName}</span>
        <span>
          <a href={linkedIn}>LinkedIn</a> · <a href={gitHub}>GitHub</a>
        </span>
      </div>
    </footer>
  </body>
</html>
