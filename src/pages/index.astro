---
import Base from '../layouts/Base.astro';

// A card without an href has no page yet and renders as plain text.
const featured: { label: string; title: string; text: string; href?: string }[] = [
  {
    label: 'Project',
    title: 'Perpetuity Machine',
    href: '/projects/perpetuity-machine/',
    text: 'A persistent, permission-aware memory layer for organizations, designed to sit beneath AI models and agents. In design.',
  },
  {
    label: 'Project',
    title: 'Care Navigator',
    href: '/projects/care-navigator/',
    text: 'Referral coordination for patients, caregivers and navigators, built on synthetic data.',
  },
  {
    label: 'Journey',
    title: 'Electrical Engineering at ASU',
    href: '/journey/',
    text: 'Starting January 2027, focusing on computer software and hardware.',
  },
];
---

<Base
  description="Rio Gonzales: an HR Director returning to engineering, building software that helps organizations remember."
>
  <section class="hero wrap">
    <p class="label accent">People · Software · Hardware</p>
    <h1>
      I’ve spent my career learning how organizations work. Now I’m building the systems
      that <strong>help them remember</strong>.
    </h1>
    <p class="lede muted">
      I’m Rio Gonzales, an HR Director returning to engineering. I build software that gives organizations a lasting
      memory, and in January 2027 I begin Electrical Engineering at ASU to learn the hardware underneath it.
    </p>
  </section>

  <section class="wrap" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="label muted">Current work</h2>
    <ul class="cards">
      {featured.map((item) => (
        <li>
          <p class="label accent">{item.label}</p>
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 5rem);
  }

  h1 {
    max-width: 26ch;
    margin-block: 1.25rem 1.5rem;
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: 0.01em;
  }

  h1 strong {
    font-weight: 500;
  }

  .lede {
    max-width: 34rem;
  }

  h2 {
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .cards {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }

  .cards li {
    padding: 1.5rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: -1px;
  }

  /* One column on phones, three across from tablet width up */
  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .cards li + li {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }

  h3 {
    margin-block: 0.9rem 0.4rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .cards .muted {
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
