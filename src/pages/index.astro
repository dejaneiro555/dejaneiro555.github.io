---
import Base from '../layouts/Base.astro';

// A card without an href has no page yet and renders as plain text.
const featured: { label: string; title: string; text: string; href?: string }[] = [
  {
    label: 'People',
    title: 'HR Command Center',
    href: '/projects/hr-command-center/',
    text: 'A multi-client HR operations workspace for requests, cases, documents and compliance follow-up.',
  },
  {
    label: 'Software',
    title: 'Perpetuity Machine',
    href: '/projects/perpetuity-machine/',
    text: 'A memory layer for organizations, designed to sit beneath AI models and agents. Its working prototype is mini-perpetuity.',
  },
  {
    label: 'Learning',
    title: 'AI/ML Engineering Curriculum',
    href: '/journey/',
    text: 'A self-directed program in ML engineering, concentrating on persistent memory for AI agents.',
  },
];
---

<Base
  description="Rio Gonzales, an HR leader becoming an AI/ML engineer: building AI memory systems so organizations keep what their people know."
>
  <section class="hero wrap">
    <p class="label accent">People · AI · Memory</p>
    <h1>
      When people leave, what they know leaves with them. I’m building systems <strong>so it doesn’t</strong>.
    </h1>
    <p class="lede muted">
      I’m Rio Gonzales, an HR leader becoming an AI/ML engineer. AI can finally give an organization a memory that
      outlasts any one person. I’m building that memory layer, and training as an engineer through a self-directed
      curriculum in ML engineering and persistent memory for AI agents.
    </p>
  </section>

  <section class="wrap" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="label muted">Current work</h2>
    <ul class="cards">
      {featured.map((item) => (
        <li>
          <p class="label accent">{item.label}</p>
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 5rem);
  }

  h1 {
    max-width: 26ch;
    margin-block: 1.25rem 1.5rem;
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: 0.01em;
  }

  h1 strong {
    font-weight: 500;
  }

  .lede {
    max-width: 34rem;
  }

  h2 {
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .cards {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }

  .cards li {
    padding: 1.5rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: -1px;
  }

  /* One column on phones, three across from tablet width up */
  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .cards li + li {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }

  h3 {
    margin-block: 0.9rem 0.4rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .cards .muted {
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
