---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Software projects by Rio Gonzales, with what each one does and where it stands.">
  <section class="page-head wrap">
    <p class="label accent">Projects</p>
    <h1>What I’m building</h1>
    <p class="muted">
      Software for work where trust matters. Security comes first in everything I build: scoped access, human approval,
      and a record of what happened. Each page says what the project does and exactly where it stands.
    </p>
  </section>

  <section class="wrap">
    <ul class="project-list">
      {projects.map((project) => (
        <li>
          <p class="label accent">{project.data.status}</p>
          <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
          <p class="muted">{project.data.summary}</p>
          <p class="label muted">{project.data.stack.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .project-list li {
    display: grid;
    gap: 0.6rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
  }

  h2 a {
    text-decoration: none;
  }

  .project-list .muted:not(.label) {
    max-width: 40rem;
  }
</style>
